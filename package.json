{
  "name": "autotest-agent",
  "displayName": "TestPilot AI",
  "description": "AI agent, ktorý overí bug či scenár priamym ovládaním aplikácie cez MCP (Playwright/Terminator) v GitHub Copilot agent mode.",
  "version": "1.1.0",
  "license": "MIT",
  "icon": "icon.png",
  "publisher": "ditec-sopko",
  "repository": {
    "type": "git",
    "url": "https://github.com/DITEC-Sopko/vscode-autotest-agent.git"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Testing"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "autotest",
          "title": "TestPilot AI",
          "icon": "sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "autotest": [
        {
          "id": "autotest.dashboardView",
          "name": "Dashboard",
          "type": "webview",
          "icon": "icon.svg"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "autotest.agent",
        "name": "autotest",
        "description": "AI Agent na automatizované testovanie a vizuálnu kontrolu",
        "isSticky": true,
        "commands": [
          {
            "name": "init",
            "description": "Inicializovať konfiguráciu agenta"
          },
          {
            "name": "model",
            "description": "Vybrať AI model s vision/OCR podporou"
          },
          {
            "name": "debug",
            "description": "Prepnúť viditeľný/neviditeľný browser"
          },
          {
            "name": "test",
            "description": "Testovať bug podľa manuálneho popisu"
          },
          {
            "name": "regenerate",
            "description": "Znova otestovať podľa upraveného scenára"
          },
          {
            "name": "history",
            "description": "Zobraziť históriu testov"
          }
        ]
      }
    ],
    "languageModelTools": [
      {
        "name": "autotest_readReport",
        "displayName": "Čítať report (Autotest)",
        "modelDescription": "Extrahuje čistý text z report/dokument súboru na lokálnom disku (PDF, DOCX, XLSX, XML, CSV, TXT). Použi tento nástroj na prečítanie obsahu reportu, ktorý aplikácia vygenerovala, namiesto otvárania súboru v prehliadači (file: URL je blokované). Vstup je absolútna cesta k súboru, výstup je extrahovaný text.",
        "toolReferenceName": "readReport",
        "canBeReferencedInPrompt": true,
        "icon": "$(file-text)",
        "tags": [
          "autotest",
          "report"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolútna cesta k report súboru (PDF/DOCX/XLSX/XML/CSV/TXT)."
            }
          },
          "required": [
            "path"
          ]
        }
      }
    ],
    "commands": [
      {
        "command": "autotest.init",
        "title": "Autotest: Inicializovať konfiguráciu"
      },
      {
        "command": "autotest.settings",
        "title": "Autotest: Nastavenia"
      },
      {
        "command": "autotest.tfsSetup",
        "title": "Autotest: Nastaviť TFS pripojenie"
      },
      {
        "command": "autotest.openDashboard",
        "title": "Autotest: Otvoriť Dashboard"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "vsce:package": "vsce package --out .",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.19",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^9.39.3",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "azure-devops-node-api": "^12.5.0",
    "fs": "^0.0.1-security",
    "mammoth": "^1.12.0",
    "path": "^0.12.7",
    "unpdf": "^1.6.2",
    "xlsx": "^0.18.5"
  }
}
